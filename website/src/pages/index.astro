  },
  {
    id: "mac",
    name: "macOS",
    detail: "Desktop app · Apple silicon & Intel",
    href: releases,
    cta: "Download",
    icon: "M16.4 12.6c0-2.4 2-3.5 2-3.6-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.2-2.8.8-3.5.8s-1.8-.8-3-.8c-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.3.9-1.3 1.3-2.5 1.3-2.6-.1 0-2.5-1-2.5-3.6ZM14.1 5.6c.6-.8 1.1-1.8 1-2.9-.9 0-2.1.6-2.7 1.4-.6.7-1.100 1.8-1 2.8 1 .1 2.1-.5 2.7-1.3Z",
  },
  {
    id: "linux",
    name: "Linux",
    detail: "Desktop app · AppImage",
    href: releases,
    cta: "Download",
    icon: "M12 2c-2 0-3.2 1.7-3.2 4.1 0 1.4.3 2.3-.6 3.7C7 11.4 5.5 13.600 5.5 16c0 .8.2 1.5.5 2.1-.8.4-1.7.7-1.7 1.5 0 1.1 2 1 3.4 1.6 1.2.5 2 .8 2.8.3.5.3 1 .5 1.5.5s1-.2 1.5-.5c.8.5 1.6.2 2.8-.3 1.4-.6 3.4-.5 3.4-1.6 0-.8-.9-1.1-1.7-1.5.3-.6.5-1.3.5-2.1 0-2.4-1.5-4.6-2.7-6.2-.9-1.4-.6-2.3-.6-3.7C15.2 3.7 14 2 12 2Zm-1.3 4a.8.8 0 1 1 0 1.6.8.8 0 0 1 0-1.6Zm2.6 0a.8.8 0 1 1 0 1.6.8.8 0 0 1 0-1.6ZM12 8.4c.9 0 1.8.5 1.8.9s-.9 1-1.8 1-1.8-.6-1.8-1 .9-.9 1.8-.9Z",
  },
  {
    id: "android",
    name: "Android",
    detail: "Phone app · APK",
    href: releases,
    cta: "Download",
    icon: "M7 9h10a1 1 0 0 1 1 1v7a2 2 0 0 1-2 2h-1v2.5a1.5 1.5 0 0 1-3 0V19h0v2.5a1.5 1.5 0 0 1-3 0V19H8a2 2 0 0 1-2-2v-7a1 1 0 0 1 1-1Zm-3 .5a1.5 1.5 0 0 1 3 0v5a1.5 1.5 0 0 1-3 0v-5Zm13 0a1.5 1.5 0 0 1 3 0v5a1.5 1.5 0 0 1-3 0v-5ZM7.2 8a4.9 4.9 0 0 1 2.6-3.7l-.9-1.6a.4.4 0 1 1 .7-.4l.9 1.6a5.6 5.6 0 0 1 3 0l.9-1.6a.4.4 0 1 1 .7.4l-.9 1.6A4.9 4.9 0 0 1 16.8 8H7.2Zm2.8-2a.7.7 0 1 0 0 1.4.7.7 0 0 0 0-1.4Zm4 0a.7.7 0 1 0 0 1.4.7.7 0 0 0 0-1.4Z",
  },
  {
    id: "web",
    name: "Browser",
    detail: "Web app served by your daemon",
    href: "/docs/desktop-mobile-cli/",
    cta: "How to open it",
    icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.5-2.5 3.5-5.5 3.5-9S14.5 5.5 12 3m0 18c-2.5-2.5-3.5-5.5-3.5-9S9.5 5.5 12 3M3.5 9h17M3.5 15h17",
    stroke: true,
  },
  {
    id: "daemon",
    name: "Daemon & CLI",
    detail: "Install script · Docker · Nix",
    href: "/docs/self-hosting/",
    cta: "Self-host",
    icon: "M4 5h16v5H4V5Zm0 9h16v5H4v-5Zm3-6.5h.01M7 16.5h.01",
    stroke: true,
  },
];

// A deterministic pseudo-QR pattern with the three finder squares.
const qrSize = 9;
const finder = (x: number, y: number) => {
  for (const [fx, fy] of [
    [0, 0],
    [qrSize - 3, 0],
    [0, qrSize - 3],
  ]) {
    if (x >= fx && x < fx + 3 && y >= fy && y < fy + 3) return !(x === fx + 1 && y === fy + 1);
  }
  return null;
};
const qrCells = Array.from({ length: qrSize * qrSize }, (_, i) => {
  const x = i % qrSize;
  const y = Math.floor(i / qrSize);
  const f = finder(x, y);
  return f ?? (x * 7 + y * 13 + x * y) % 3 === 0;
});
---

<SiteLayout
  title="FDE: run and monitor coding agents from anywhere"
  description="FDE (Frogg Development Environment) runs Claude Code, Codex, OpenCode and more on a daemon you host, and lets you watch, steer and approve them from desktop, phone, browser or CLI."
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="grid-bg" aria-hidden="true"></div>

    <div class="container hero-inner">
      <div class="logo-wrap">
        <span class="logo-glow" aria-hidden="true"></span>
        <Image
          src={logo}
          alt="FDE origami frog logo"
          width={132}
          height={103}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
          class="hero-logo"
        />
      </div>

      <p class="badge">
        <span class="badge-dot" aria-hidden="true"></span> Open source · Self-hosted · Apache-2.0
      </p>

      <h1>
        Your coding agents,<br /><span class="gradient-text">wherever you are.</span>
      </h1>
      <p class="lead">
        FDE runs Claude Code, Codex, OpenCode and more on a daemon you host. Watch them work, answer
        their questions and approve their commands from your desktop, phone, browser or terminal.
      </p>

      <div class="hero-cta">
        <a class="btn btn-primary" href="/docs/getting-started/"
          >Get started <span class="arrow" aria-hidden="true">→</span></a
        >
        <a class="btn" href="#download">Download</a>
      </div>

      <div class="hero-install">
        <InstallCommand />
        <p class="install-note">
          Installs the daemon and <code>fde</code> CLI on Linux or macOS. <a href="/docs/self-hosting/"
            >Other options</a
          >
        </p>
      </div>
    </div>

    <div class="container stage">
      <div class="window-tilt">
        <AppWindow />
      </div>
    </div>
  </section>

  <!-- ================= PROVIDERS ================= -->
  <section class="providers" aria-labelledby="providers-title">
    <div class="container">
      <h2 id="providers-title" class="providers-title">Bring the agents you already use</h2>
      <ul class="provider-list">
        {
          providers.map((p, i) => (
            <li data-reveal style={`--reveal-delay:${i * 50}`}>
              <ProviderIcon name={p.icon} size={18} />
              {p.name}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= WHAT IT IS ================= -->
  <section id="features" class="section">
    <div class="container">
      <div class="split-head" data-reveal>
        <p class="eyebrow">What it is</p>
        <h2 class="section-title">One daemon runs the agents.<br />Every screen can drive them.</h2>
        <p class="section-lead">
          The FDE daemon lives on your laptop, a build box or a container. It launches the agent CLIs
          next to your code and keeps them going. The apps are windows onto it, so you can close the
          laptop, pick up your phone and carry on.
        </p>
      </div>

      <figure class="topology" data-reveal>
        <div class="node daemon-node">
          <span class="node-kicker">Your machine, server or container</span>
          <strong>FDE daemon</strong>
          <span class="chips">
            <span>agents</span><span>worktrees</span><span>terminals</span><span>schedules</span>
          </span>
        </div>
        <div class="links" aria-hidden="true">
          <svg viewBox="0 0 400 60" preserveAspectRatio="none">
            <path d="M200 0 C200 30 50 30 50 60"></path>
            <path d="M200 0 C200 30 150 30 150 60"></path>
            <path d="M200 0 C200 30 250 30 250 60"></path>
            <path d="M200 0 C200 30 350 30 350 60"></path>
          </svg>
        </div>
        <ul class="clients" aria-label="Clients">
          <li>Desktop</li>
          <li>Phone</li>
          <li>Browser</li>
          <li>CLI</li>
        </ul>
        <figcaption class="sr-only">
          The FDE daemon runs on your hardware; desktop, phone, browser and CLI clients connect to it.
        </figcaption>
      </figure>

      <div class="features">
        {
          features.map((f, i) => (
            <article class="feature card" data-reveal style={`--reveal-delay:${(i % 3) * 80}`}>
              <span class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <path
                    d={f.icon}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= DOWNLOAD ================= -->
  <section id="download" class="section download">
    <div class="container">
      <div class="center-head" data-reveal>
        <p class="eyebrow">Platforms</p>
        <h2 class="section-title">Install the daemon once.<br />Connect from everything.</h2>
        <p class="section-lead">
          Put the daemon wherever your code lives, then open it from any client. Every app is a free
          download from GitHub Releases.
        </p>
      </div>

      <div class="install-panel card" data-reveal>
        <div class="install-panel-text">
          <span class="step-num" aria-hidden="true">1</span>
          <div>
            <h3>Run the daemon</h3>
            <p>
              One command on Linux or macOS installs the daemon as a user service and adds the <code
                >fde</code
              > CLI.
            </p>
          </div>
        </div>
        <InstallCommand label="Copy daemon install command" />
      </div>

      <div class="step-row" data-reveal>
        <span class="step-num" aria-hidden="true">2</span>
        <h3>Pick a client</h3>
      </div>
      <ul class="platforms">
        {
          platforms.map((p, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 3) * 70}`}>
              <a class="platform card" href={p.href} data-platform={p.id}>
                <span class="platform-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="26" height="26">
                    {p.stroke ? (
                      <path
                        d={p.icon}
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    ) : (
                      <path d={p.icon} fill="currentColor" />
                    )}
                  </svg>
                </span>
                <span class="platform-text">
                  <strong>{p.name}</strong>
                  <span>{p.detail}</span>
                </span>
                <span class="platform-cta">
                  {p.cta} <span class="arrow" aria-hidden="true">→</span>
                </span>
                <span class="your-os" hidden>
                  Your device
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="fine-print" data-reveal>
        Desktop apps connect to daemons rather than bundling one. Builds and checksums live on <a
          href={`${repo}/releases`}>GitHub Releases</a
        >.
      </p>
    </div>
  </section>

  <!-- ================= COMPANION ================= -->
  <section id="companion" class="section companion">
    <div class="container companion-grid">
      <div data-reveal>
        <p class="eyebrow">Companion · voice</p>
        <h2 class="section-title">
          Talk to your agents.<br /><span class="gradient-text">Hands free.</span>
        </h2>
        <p class="section-lead">
          Companion is a real-time voice conversation that sits above your projects. It answers
          straight away, hands real work to your coding agents, and tells you when they finish or
          get stuck.
        </p>
        <ul class="ticks">
          <li>Dispatches tasks to agents in the project you pick and follows them through</li>
          <li>Announces completions and failures, and lets you answer permission requests by voice</li>
          <li>Local speech recognition and synthesis by default</li>
          <li>Orchestrates with your Claude or Codex subscription; off until you enable it</li>
        </ul>
        <a class="btn" href="/docs/using-fde/"
          >Read about Companion <span class="arrow" aria-hidden="true">→</span></a
        >
      </div>

      <div class="companion-visual" data-reveal aria-hidden="true">
        <div class="orb">
          <span class="ribbon r1"></span><span class="ribbon r2"></span><span class="ribbon r3"
          ></span>
          <span class="orb-core"></span>
        </div>
        <div class="bubbles">
          <p class="bubble you">How's the upload rate limiting going?</p>
          <p class="bubble fde">
            Claude finished it a few minutes ago. Tests pass, and it's asking to push the branch.
          </p>
          <p class="bubble you">Let it push, then have Codex look at the flaky CI job.</p>
          <p class="bubble fde status">
            <span class="eq"><i></i><i></i><i></i><i></i></span> On it. I'll tell you when it's done.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PAIRING ================= -->
  <section id="pairing" class="section pairing">
    <div class="container pairing-grid">
      <div class="phone-wrap" data-reveal aria-hidden="true">
        <div class="phone">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="ph-head">
              <span class="ph-host"><i></i>build-box</span>
              <span class="ph-title">Fix flaky CI job</span>
              <span class="ph-sub">Codex · running 6m</span>
            </div>
            <div class="ph-line"><span class="ok">✓</span> Found the race in <code>queue.spec.ts</code></div>
            <div class="ph-line"><span class="ok">✓</span> Patched retry timing</div>
            <div class="ph-card">
              <strong>Codex wants to run</strong>
              <code>npm run test:ci -- --repeat 20</code>
              <div class="ph-actions"><span>Deny</span><span class="allow">Allow</span></div>
            </div>
            <div class="ph-composer">Reply…</div>
          </div>
        </div>
        <div class="qr-card">
          <div class="qr">
            {qrCells.map((on) => <i class:list={{ on }} />)}
          </div>
          <span>Scan to pair</span>
        </div>
      </div>

      <div data-reveal>
        <p class="eyebrow">Pair your phone</p>
        <h2 class="section-title">Scan once.<br />Keep your agents in your pocket.</h2>
        <p class="section-lead">
          Run <code>fde daemon pair</code> on the host and scan the code with the FDE app. From then on
          the phone sees the same agents, timelines and prompts as your desktop.
        </p>
        <ul class="pair-steps">
          <li><strong>Direct</strong> over your LAN, Tailscale or another VPN.</li>
          <li><strong>SSH</strong> from the desktop app to a remote host.</li>
          <li><strong>Relay</strong> that you operate, end-to-end encrypted between app and daemon.</li>
        </ul>
        <p class="note">
          The pairing page never contacts your daemon: the code carries the whole offer, and nothing
          is stored.
        </p>
        <a class="btn" href="/docs/desktop-mobile-cli/"
          >Pairing guide <span class="arrow" aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </section>

  <!-- ================= MAKE IT YOURS ================= -->
  <section id="make-it-yours" class="section yours">
    <div class="container">
      <div class="yours-panel" data-reveal>
        <div class="yours-glow" aria-hidden="true"></div>
        <div class="yours-copy">
          <p class="eyebrow">Make it yours</p>
          <h2 class="section-title">
            Fork it. Rebrand it.<br /><span class="gradient-text">Ship your own build.</span>
          </h2>
          <p class="section-lead">
            Branding is data, not a patch series. Describe your product in one <code>brand.json</code>
            and the build carries your name, icon, colours, app IDs, installers and update feed, while
            you keep pulling upstream FDE.
          </p>
          <ol class="yours-steps">
            <li>
              <span aria-hidden="true">1</span>
              <div><strong>Fork</strong> <code>frogg-app/fde</code> on GitHub</div>
            </li>
            <li>
              <span aria-hidden="true">2</span>
              <div><strong>Describe</strong> your app in <code>brands/your-app/brand.json</code></div>
            </li>
            <li>
              <span aria-hidden="true">3</span>
              <div><strong>Ship</strong> desktop, Android and daemon builds from your own releases</div>
            </li>
            <li>
              <span aria-hidden="true">4</span>
              <div><strong>Keep pulling upstream</strong>: your brand lives in its own folder</div>
            </li>
          </ol>
          <div class="yours-cta">
            <a class="btn btn-primary" href="/docs/fork-and-rebrand/"
              >Fork & rebrand guide <span class="arrow" aria-hidden="true">→</span></a
            >
            <a class="btn" href={`${repo}/fork`}>Fork on GitHub</a>
          </div>
        </div>

        <div class="yours-demo" aria-hidden="true">
          <div class="brand-json">
            <div class="bj-bar"><span>brands/acme/brand.json</span></div>
            <pre><code><span class="k">"name"</span>: <span class="s">"<span class="cycle-name">Acme Studio</span>"</span>,
<span class="k">"applicationId"</span>: <span class="s">"com.acme.studio"</span>,
<span class="k">"daemonPort"</span>: <span class="n">10099</span>,
<span class="k">"colors"</span>: {"{"}
  <span class="k">"dark"</span>: {"{"}
    <span class="k">"accent"</span>: <span class="swatch-inline"></span><span class="s cycle-hex">"#c4b5fd"</span>,
    <span class="k">"background"</span>: <span class="s">"#1b1621"</span>
  {"}"}
{"}"}</code></pre>
          </div>
          <div class="mini-app">
            <div class="mini-bar"><i></i><i></i><i></i><span class="cycle-name">Acme Studio</span></div>
            <div class="mini-body">
              <div class="mini-side"><b></b><span></span><span class="on"></span><span></span></div>
              <div class="mini-main">
                <span class="mini-msg"></span><span class="mini-msg short"></span>
                <span class="mini-btn">Allow</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= FINAL CTA ================= -->
  <section class="section final">
    <div class="container final-inner" data-reveal>
      <Image src={logo} alt="" width={72} height={56} densities={[1, 2]} class="final-logo" />
      <h2 class="section-title">Put your agents to work.</h2>
      <p class="section-lead">Install the daemon, connect a client, start an agent.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/docs/getting-started/"
          >Get started <span class="arrow" aria-hidden="true">→</span></a
        >
        <a class="btn" href={repo}>Star on GitHub</a>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // Highlight the download card for the visitor's platform.
  const ua = navigator.userAgent;
  const platform = /android/i.test(ua)
    ? "android"
    : /iphone|ipad|ipod/i.test(ua)
      ? "web"
      : /mac/i.test(ua)
        ? "mac"
        : /win/i.test(ua)
          ? "windows"
          : /linux/i.test(ua)
            ? "linux"
            : null;
  const card = platform && document.querySelector<HTMLElement>(`[data-platform="${platform}"]`);
  if (card) {
    card.classList.add("is-yours");
    card.querySelector<HTMLElement>(".your-os")?.removeAttribute("hidden");
  }

  // Cycle the rebrand demo through a few palettes while it is on screen.
  const demo = document.querySelector<HTMLElement>(".yours-demo");
  const brands = [
    { name: "Acme Studio", accent: "#c4b5fd" },
    { name: "Ember Code", accent: "#fb923c" },
    { name: "Moss Dev", accent: "#4ade80" },
    { name: "FDE", accent: "#25b5c8" },
  ];
  if (demo && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let i = 0;
    let timer = 0;
    const apply = () => {
      const b = brands[i];
      demo.style.setProperty("--demo-accent", b.accent);
      demo.querySelectorAll(".cycle-name").forEach((el) => (el.textContent = b.name));
      demo.querySelectorAll(".cycle-hex").forEach((el) => (el.textContent = `"${b.accent}"`));
    };
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !timer) {
        timer = window.setInterval(() => {
          i = (i + 1) % brands.length;
          apply();
        }, 2200);
      } else if (!entry.isIntersecting) {
        window.clearInterval(timer);
        timer = 0;
      }
    }).observe(demo);
  }
</script>


---
import { Image } from "astro:assets";
import logo from "../../assets/brand/fde-logo.png";
import ThemeToggle from "../theme/ThemeToggle.astro";

const links = [
  { href: "/#features", label: "Features" },
  { href: "/#download", label: "Download" },
  { href: "/#companion", label: "Companion" },
  { href: "/#make-it-yours", label: "Make it yours" },
  { href: "/docs/", label: "Docs" },
];
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label="FDE home">
      <Image src={logo} alt="" width={36} height={28} densities={[1, 2]} loading="eager" fetchpriority="high" />
      <span>FDE</span>
    </a>

    <nav class="desktop-nav" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="actions">
      <a class="icon-btn" href="https://github.com/frogg-app/fde" aria-label="FDE on GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
          ></path></svg
        >
      </a>
      <ThemeToggle />
      <a class="btn btn-primary btn-sm cta" href="/docs/getting-started/">Get started</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Main" hidden>
    {links.map((link, i) => <a href={link.href} style={`--i:${i}`}>{link.label}</a>)}
    <a class="btn btn-primary" href="/docs/getting-started/" style={`--i:${links.length}`}>Get started</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const button = header.querySelector<HTMLButtonElement>(".menu-btn")!;
  const nav = header.querySelector<HTMLElement>("#mobile-nav")!;

  const setOpen = (open: boolean) => {
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    header.classList.toggle("menu-open", open);
    document.documentElement.classList.toggle("no-scroll", open);
    if (open) {
      nav.hidden = false;
      requestAnimationFrame(() => nav.classList.add("open"));
    } else {
      nav.classList.remove("open");
      setTimeout(() => {
        if (!nav.classList.contains("open")) nav.hidden = true;
      }, 220);
    }
  };

  button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
  nav.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && header.classList.contains("menu-open")) {
      setOpen(false);
      button.focus();
    }
  });
  matchMedia("(min-width: 56rem)").addEventListener("change", (e) => e.matches && setOpen(false));

  // Solid header once the page scrolls.
  const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Highlight the section in view.
  const navLinks = [...header.querySelectorAll<HTMLAnchorElement>('.desktop-nav a[href^="/#"]')];
  const sections = navLinks
    .map((a) => document.getElementById(a.hash.slice(1)))
    .filter((s): s is HTMLElement => !!s);
  if (sections.length && "IntersectionObserver" in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          navLinks.forEach((a) =>
            a.toggleAttribute("aria-current", a.hash === `#${entry.target.id}`),
          );
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((s) => spy.observe(s));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--fde-med) var(--fde-ease),
      border-color var(--fde-med) var(--fde-ease),
      backdrop-filter var(--fde-med) var(--fde-ease);
  }
  .site-header.scrolled,
  .site-header.menu-open {
    background: color-mix(in srgb, var(--fde-bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom-color: var(--fde-border);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: var(--site-width);
    margin: 0 auto;
    padding: 0.7rem var(--site-pad);
    height: 3.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 750;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--fde-text);
    text-decoration: none;
    border-radius: var(--fde-radius-sm);
  }
  .brand img {
    width: 36px;
    height: auto;
    transition: transform var(--fde-med) var(--fde-ease-spring);
  }
  .brand:hover img {
    transform: rotate(-8deg) scale(1.08);
  }
  .desktop-nav {
    display: none;
    gap: 0.25rem;
    margin-right: auto;
  }
  .desktop-nav a {
    position: relative;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--fde-text-muted);
    text-decoration: none;
    transition:
      color var(--fde-fast) var(--fde-ease),
      background-color var(--fde-fast) var(--fde-ease);
  }
  .desktop-nav a:hover {
    color: var(--fde-text);
    background: var(--fde-accent-soft);
  }
  .desktop-nav a[aria-current] {
    color: var(--fde-text);
  }
  .desktop-nav a[aria-current]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.15rem;
    width: 0.3rem;
    height: 0.3rem;
    margin-left: -0.15rem;
    border-radius: 50%;
    background: var(--fde-accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--fde-text-muted);
    transition:
      color var(--fde-fast) var(--fde-ease),
      background-color var(--fde-fast) var(--fde-ease),
      transform var(--fde-fast) var(--fde-ease);
  }
  .icon-btn:hover {
    color: var(--fde-text);
    background: var(--fde-accent-soft);
  }
  .icon-btn:active {
    transform: scale(0.92);
  }
  .cta {
    display: none;
  }
  .menu-btn {
    display: inline-grid;
    place-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--fde-border);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    transition: background-color var(--fde-fast) var(--fde-ease);
  }
  .menu-btn:active {
    background: var(--fde-accent-soft);
  }
  .menu-btn span {
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--fde-text);
    transition: transform var(--fde-med) var(--fde-ease);
  }
  .menu-open .menu-btn span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-open .menu-btn span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  .mobile-nav {
    display: grid;
    gap: 0.25rem;
    padding: 0.5rem var(--site-pad) 1.25rem;
    height: calc(100dvh - 3.75rem);
    align-content: start;
    overflow-y: auto;
  }
  .mobile-nav[hidden] {
    display: none;
  }
  .mobile-nav a:not(.btn) {
    padding: 0.9rem 0.25rem;
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--fde-text);
    text-decoration: none;
    border-bottom: 1px solid var(--fde-border);
  }
  .mobile-nav a:not(.btn):active {
    color: var(--fde-accent-bright);
  }
  .mobile-nav .btn {
    margin-top: 1rem;
  }
  .mobile-nav a {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 200ms var(--fde-ease),
      transform 260ms var(--fde-ease);
    transition-delay: calc(var(--i) * 30ms);
  }
  .mobile-nav.open a {
    opacity: 1;
    transform: none;
  }
  @media (min-width: 56rem) {
    .desktop-nav {
      display: flex;
    }
    .cta {
      display: inline-flex;
    }
    .menu-btn,
    .mobile-nav {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav a {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

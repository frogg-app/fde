{
  "worktree": {
    "setup": [
      "npm ci",
      "node ./scripts/mobile/seed-ios-native-cache.mjs",
      "node ./scripts/dev/seed-worktree-dev-state.mjs",
      "npm run build:server",
      "npm run build --workspace=@fde/expo-two-way-audio"
    ]
  },
  "scripts": {
    "daemon": {
      "type": "service",
      "command": "FDE_DEV_MANAGED_HOME=1 FDE_DEV_ROOT=\"${FDE_WORKTREE_PATH:-$PWD}\" FDE_HOME=\"${FDE_WORKTREE_PATH:-$PWD}/.dev/fde-home\" FDE_SKIP_DEV_SERVER_BUILD=1 FDE_LISTEN=0.0.0.0:${FDE_PORT:-6768} ./scripts/dev/dev-daemon.sh"
    },
    "app": {
      "type": "service",
      "command": "FDE_DEV_MANAGED_HOME=1 FDE_DEV_ROOT=\"${FDE_WORKTREE_PATH:-$PWD}\" FDE_HOME=\"${FDE_WORKTREE_PATH:-$PWD}/.dev/fde-home\" FDE_LISTEN=0.0.0.0:${FDE_SERVICE_DAEMON_PORT:-6768} FDE_DEV_DAEMON_ENDPOINT=localhost:${FDE_SERVICE_DAEMON_PORT:-6768} EXPO_PORT=${FDE_PORT:-} ./scripts/dev/dev-app.sh"
    },
    "desktop": {
      "type": "service",
      "command": "FDE_DEV_MANAGED_HOME=1 FDE_DEV_ROOT=\"${FDE_WORKTREE_PATH:-$PWD}\" FDE_HOME=\"${FDE_WORKTREE_PATH:-$PWD}/.dev/fde-home\" FDE_LISTEN=0.0.0.0:${FDE_SERVICE_DAEMON_PORT:-6768} FDE_DEV_DAEMON_ENDPOINT=localhost:${FDE_SERVICE_DAEMON_PORT:-6768} EXPO_PORT=${FDE_PORT:-} exec ./packages/desktop/scripts/dev.sh"
    },
    "ios-simulator": {
      "type": "service",
      "command": "FDE_DEV_MANAGED_HOME=1 FDE_DEV_ROOT=\"$PWD\" FDE_HOME=\"$PWD/.dev/fde-home\" FDE_LISTEN=0.0.0.0:${FDE_SERVICE_DAEMON_PORT} FDE_DEV_DAEMON_ENDPOINT=localhost:${FDE_SERVICE_DAEMON_PORT} ./scripts/mobile/fde-ios-simulator-service.sh"
    },
    "typecheck": {
      "command": "npm run typecheck"
    }
  }
}

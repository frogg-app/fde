{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frogg DE",
  "version": "0.1.2",
  "identifier": "app.frogg.de",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npm run build:bridge",
    "beforeBuildCommand": "npm run build:bridge"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Frogg DE",
    "longDescription": "Desktop client for local and remote AI coding agents.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY",
      "endpoints": ["https://github.com/frogg-app/frogg-de/releases/latest/download/latest.json"]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["paseo"]
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FDE",
  "version": "0.1.15",
  "identifier": "app.frogg.fde",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npm run build:bridge",
    "beforeBuildCommand": "npm run build:bridge"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "FDE",
    "longDescription": "Frogg Development Environment: desktop client for local and remote AI coding agents.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/frogg-app/fde/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "paseo"
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*){2,}$"
    },
    "daemonPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "fullName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "cliName": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "desktopBinaryName": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "homeDir": {
      "type": "string",
      "pattern": "^\\.[a-z][a-z0-9-]*$"
    },
    "envPrefix": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "scheme": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "serviceName": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "launchdLabel": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "artifactPrefix": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$"
    },
    "assets": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "ios": {
          "type": "string",
          "minLength": 1
        },
        "foreground": {
          "type": "string",
          "minLength": 1
        },
        "notification": {
          "type": "string",
          "minLength": 1
        },
        "splash": {
          "type": "string",
          "minLength": 1
        },
        "faviconLight": {
          "type": "string",
          "minLength": 1
        },
        "faviconDark": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["icon"],
      "additionalProperties": false
    },
    "colors": {
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "properties": {
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accentForeground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "foreground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accentBright": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": ["accent", "accentForeground", "background", "foreground"],
          "additionalProperties": false
        },
        "dark": {
          "type": "object",
          "properties": {
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accentForeground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "foreground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accentBright": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": ["accent", "accentForeground", "background", "foreground"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "website": {
          "type": "string",
          "format": "uri"
        },
        "support": {
          "type": "string",
          "format": "uri"
        },
        "docs": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "installer": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "properties": {
        "pairingUrl": {
          "type": "string",
          "format": "uri"
        },
        "relayEndpoint": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.[\\]:-]+$"
        },
        "relayUseTls": {
          "type": "boolean"
        },
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+\\/[a-zA-Z0-9_.-]+$"
        },
        "updates": {
          "type": "string",
          "enum": ["disabled", "github-release", "tauri-signed"]
        },
        "updaterPublicKey": {
          "type": "string",
          "minLength": 1
        },
        "dockerImage": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./_-]*$"
        },
        "pairingImage": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./_-]*$"
        },
        "iosStoreId": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "expoProjectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "id", "name", "applicationId", "daemonPort", "assets"],
  "additionalProperties": false
}
